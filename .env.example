# CampusClaw Nexus configuration template. No real credentials belong here.
# Copy to a private .env outside Git, then fill required secrets.
APP_ENV=demo
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_DB=campusclaw_nexus
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

JWT_SIGNING_KEY=
JWT_ISSUER=campusclaw-nexus
JWT_AUDIENCE=campusclaw-web
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_ID=
EMBEDDING_API_KEY=

MATERIAL_STORAGE_PATH=/app/data/materials
UPLOAD_MAX_MB=10
LLM_TIMEOUT_SECONDS=60
MCP_TOOL_TIMEOUT_SECONDS=15
MAX_LLM_CONCURRENCY=
QUEUE_MAX_RETRIES=3
LOG_LEVEL=INFO

SEED_DEMO_DATA=false
SEED_PASSWORD=
TEST_BASE_URL=
VITE_API_BASE_URL=/api
